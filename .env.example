# SEC fair-access policy: a real contact (name and email) is required.
SEC_USER_AGENT=Your Name you@example.com
DATABASE_URL=postgresql://filings:filings@127.0.0.1:5442/filings
OLLAMA_URL=http://127.0.0.1:11434
ANSWER_MODEL=qwen3:8b
EMBEDDING_MODEL=nomic-embed-text
# Companies `filings ingest` indexes by default (tracked domestic filers).
INGEST_TICKERS=NVDA,AMD,AVGO,MSFT,AMZN,GOOGL,META,INTC,MU,AMAT,LRCX,KLAC
# Optional checks. On the dev set neither fired; see docs/decisions.tsv.
# DROP_UNSUPPORTED_PERIODS=true
# CHECK_FACT_DURATIONS=true
# Search each side of a comparison by its topic. Raises retrieval; answers are mixed.
# COMPARISON_TOPIC_QUERIES=true
# Index 20-F filers (TSM, ASML, ARM). No evaluation questions cover them yet.
# INGEST_FOREIGN_FILERS=true
